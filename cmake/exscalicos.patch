diff --git a/include/common/ExscalicosShortRange.hpp b/include/common/ExscalicosShortRange.hpp
new file mode 100644
index 0000000..3bc4dd4
--- /dev/null
+++ b/include/common/ExscalicosShortRange.hpp
@@ -0,0 +1,51 @@
+#ifndef EXSCALICOS_EXSCALICOSSHORTRANGE_HPP_INCLUDED
+#define EXSCALICOS_EXSCALICOSSHORTRANGE_HPP_INCLUDED
+
+#include <Kokkos_Macros.hpp>
+#include <Kokkos_MathematicalFunctions.hpp>
+
+#include <concepts>
+#include <numbers>
+
+/**
+ * short-range (real-space) kernels of the Ewald splitting, for use in the near-field
+ * computation of a calling code; the kernels contain no charges and no prefactors
+ *
+ * erfc is evaluated with the approximation of Abramowitz and Stegun (Eq. 7.1.26),
+ * with an absolute error below 1.5e-7, which shares the exponential with the
+ * Gaussian term of the field
+ */
+template <std::floating_point FPT>
+struct ExscalicosEwaldShortRange
+{
+    /// @brief Ewald splitting parameter
+    FPT alpha;
+
+    /// @brief erfc(x) * exp(x^2) for x >= 0 (Abramowitz and Stegun, Eq. 7.1.26)
+    KOKKOS_INLINE_FUNCTION static FPT scaledErfc(FPT x)
+    {
+        const FPT t = (FPT)1.0 / ((FPT)1.0 + (FPT)0.3275911 * x);
+        return t * ((FPT)0.254829592 +
+                    t * ((FPT)-0.284496736 +
+                         t * ((FPT)1.421413741 +
+                              t * ((FPT)-1.453152027 + t * (FPT)1.061405429))));
+    }
+
+    /// @brief field magnitude of a unit charge at distance dist, divided by dist
+    KOKKOS_INLINE_FUNCTION FPT field(FPT dist) const
+    {
+        const FPT x        = alpha * dist;
+        const FPT gaussian = Kokkos::exp(-x * x);
+        return gaussian * ((FPT)2.0 * alpha * std::numbers::inv_sqrtpi_v<FPT> + scaledErfc(x) / dist) /
+               (dist * dist);
+    }
+
+    /// @brief potential of a unit charge at distance dist
+    KOKKOS_INLINE_FUNCTION FPT potential(FPT dist) const
+    {
+        const FPT x = alpha * dist;
+        return Kokkos::exp(-x * x) * scaledErfc(x) / dist;
+    }
+};
+
+#endif
